generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum CafeSource {
  overture
  user
}

enum CafeStatus {
  active
  possibly_closed
  closed
  hidden
}

enum OvertureStatus {
  open
  temporarily_closed
  permanently_closed
  unknown
}

enum SuggestionStatus {
  pending
  approved
  rejected
  merged
}

enum RatingStatus {
  visible
  hidden
}

enum MilkType {
  whole
  oat
  lactose_free
  other
}

enum Size {
  regular
  large
}

enum ReportReason {
  spam
  offensive
  wrong_place
  other
}

enum ReportStatus {
  open
  actioned
  dismissed
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  googleSub   String?   @unique
  email       String?   @unique
  displayName String?
  nickname    String?   @unique
  avatarUrl   String?
  role        Role      @default(user)
  createdAt   DateTime  @default(now()) @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz

  sessions          Session[]
  ratings           Rating[]
  suggestions       CafeSuggestion[] @relation("SuggestionAuthor")
  reviewedSuggestions CafeSuggestion[] @relation("SuggestionReviewer")
  reports           RatingReport[]
  wantToTry         WantToTry[]
  adminActions      AdminAction[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  lastSeenAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cafe {
  id               String         @id @default(uuid()) @db.Uuid
  overtureId       String?        @unique
  source           CafeSource
  slug             String         @unique
  name             String
  normalizedName   String
  addressLine      String?
  neighborhood     String?
  freguesia        String?
  latitude         Float
  longitude        Float
  specialty        Boolean        @default(false)
  status           CafeStatus     @default(active)
  overtureStatus   OvertureStatus @default(unknown)
  createdAt        DateTime       @default(now()) @db.Timestamptz
  updatedAt        DateTime       @updatedAt @db.Timestamptz
  lastImportedAt   DateTime?      @db.Timestamptz

  ratings      Rating[]
  suggestions  CafeSuggestion[] @relation("SuggestionMatch")
  wantToTry    WantToTry[]

  @@index([status, latitude, longitude])
  @@index([normalizedName])
  @@index([freguesia, status])
}

model CafeSuggestion {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  name          String
  addressLine   String?
  latitude      Float?
  longitude     Float?
  note          String?
  status        SuggestionStatus @default(pending)
  matchedCafeId String?          @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz
  reviewedAt    DateTime?        @db.Timestamptz
  reviewedBy    String?          @db.Uuid

  user        User  @relation("SuggestionAuthor", fields: [userId], references: [id])
  reviewer    User? @relation("SuggestionReviewer", fields: [reviewedBy], references: [id])
  matchedCafe Cafe? @relation("SuggestionMatch", fields: [matchedCafeId], references: [id])

  @@index([status, createdAt])
}

model Rating {
  id           String       @id @default(uuid()) @db.Uuid
  cafeId       String       @db.Uuid
  userId       String?      @db.Uuid
  taste        Int          @db.SmallInt
  milkTexture  Int          @db.SmallInt
  temperature  Int          @db.SmallInt
  value        Int          @db.SmallInt
  priceCents   Int
  currency     String       @default("EUR") @db.Char(3)
  milkType     MilkType     @default(whole)
  size         Size         @default(regular)
  visitedOn    DateTime     @db.Date
  note         String?
  status       RatingStatus @default(visible)
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz

  cafe         Cafe            @relation(fields: [cafeId], references: [id])
  user         User?           @relation(fields: [userId], references: [id])
  revisions    RatingRevision[]
  reports      RatingReport[]

  @@index([cafeId, status, visitedOn])
  @@index([userId, createdAt])
}

model RatingRevision {
  id        String   @id @default(uuid()) @db.Uuid
  ratingId  String   @db.Uuid
  snapshot  Json
  createdAt DateTime @default(now()) @db.Timestamptz

  rating Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)

  @@index([ratingId])
}

model RatingReport {
  id             String       @id @default(uuid()) @db.Uuid
  ratingId       String       @db.Uuid
  reporterUserId String       @db.Uuid
  reason         ReportReason
  status         ReportStatus @default(open)
  createdAt      DateTime     @default(now()) @db.Timestamptz
  resolvedAt     DateTime?    @db.Timestamptz

  rating   Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  reporter User   @relation(fields: [reporterUserId], references: [id])

  @@unique([ratingId, reporterUserId])
}

model WantToTry {
  userId    String   @db.Uuid
  cafeId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([userId, cafeId])
}

model AdminAction {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String
  targetType  String
  targetId    String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([targetType, targetId])
}
